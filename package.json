{
  "name": "hotel-management-backend",
  "version": "1.0.0",
  "description": "Hotel Management Backend with MySQL, Knex, JWT, and Express-Validator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "generate:postman": "node scripts/generate_postman.js"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@sparticuz/chromium": "^148.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.9",
    "puppeteer": "^24.43.1",
    "puppeteer-core": "^24.43.1",
    "socket.io": "^4.8.4"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true
  }
}
