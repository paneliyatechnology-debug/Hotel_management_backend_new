{
  "name": "hotel-management-backend",
  "version": "1.0.0",
  "description": "Hotel Management Backend with MySQL, Knex, JWT, and Express-Validator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "node tests/hotelRegistration.test.js && node tests/subscriptionPlan.test.js && node tests/roomType.test.js && node tests/physicalRoom.test.js && node tests/booking.test.js && node tests/user.test.js && node tests/imageReplacement.test.js",
    "test:hotels": "node tests/hotelRegistration.test.js",
    "test:plans": "node tests/subscriptionPlan.test.js",
    "test:room-types": "node tests/roomType.test.js",
    "test:rooms": "node tests/physicalRoom.test.js",
    "test:bookings": "node tests/booking.test.js",
    "test:users": "node tests/user.test.js",
    "generate:postman": "node scripts/generate_postman.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
