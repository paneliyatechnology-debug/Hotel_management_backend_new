# Copy to .env and fill in the values. Never commit real secrets.

# Application
NODE_ENV=development
PORT=5001
APP_NAME="Hotel Management Backend"

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_management_db

# Authentication (JWT)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URLs
# Web app hotel owners and staff use (login). Links in welcome, staff and reset-password emails point here.
FRONTEND_URL=http://localhost:3000
# Optional. Overrides FRONTEND_URL for email links only.
RESET_PASSWORD_URL=
# Super admin console. Used for CORS only, never in email links.
ADMIN_URL=https://your-admin-portal.example.com

# Email (Brevo)
BREVO_API_KEY=
# Use an address on YOUR OWN domain (not gmail/yahoo/outlook) and authenticate that domain in Brevo
# (SPF, DKIM, DMARC). A free-mail sender is sent to spam and delayed.
BREVO_SENDER_EMAIL=no-reply@your-domain.example.com
FROM_NAME=MYOWNPMS
# Optional. Where replies go. Defaults to SUPPORT_EMAIL.
REPLY_TO_EMAIL=

# WhatsApp Cloud API (booking confirmation)
# One sender number is used for every hotel. The message names the hotel on the booking.
# Leave the token empty to log the confirmation without calling WhatsApp.
# Approve this body template in Meta (name booking_confirmation, language en) before sending:
#   Hello {{1}}, your stay at {{2}} is confirmed.
#   Booking: {{3}}
#   Room: {{4}}
#   Check-in: {{5}}
#   Check-out: {{6}}
#   Total: {{7}}
# Variables, in order: guest name, hotel name, booking number, room details, check-in, check-out, total amount.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOOKING_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0
# Prefixed when the guest mobile has no country code (10 digits).
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Image storage (S3-compatible)
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
