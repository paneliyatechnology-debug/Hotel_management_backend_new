# Copy to .env and fill in the values. Never commit real secrets.

# Application
NODE_ENV=development
PORT=5001
APP_NAME="Hotel Management Backend"

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_management_db

# Authentication (JWT)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=https://your-admin-portal.example.com

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_verified_sender@example.com
FROM_NAME=MYOWNPMS

# Image storage (S3-compatible)
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
