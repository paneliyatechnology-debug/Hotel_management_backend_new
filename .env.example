# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration (Knex)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_management_db

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_2026
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Email Transporter (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Hotel Management <no-reply@hotelmanagement.com>"
