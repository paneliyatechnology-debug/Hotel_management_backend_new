# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Admin Portal URL (For Welcome Emails & Password Setup Links)
ADMIN_URL=https://hotel-management-admin-livid.vercel.app

# MySQL Database Configuration (Knex)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_management_db

# Redis & BullMQ Configuration (Optional: runs resilient in-memory async queue if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_2026
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Brevo (Sendinblue) Transactional Email API (HTTPS Port 443)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
FROM_NAME="MYOWNPMS"
